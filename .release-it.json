{
  "$schema": "https://unpkg.com/release-it/schema/release-it.json",
  "npm": {
    "publish": false
  },
  "git": {
    "commit": true,
    "tag": true,
    "push": true,
    "tagName": "v${version}",
    "commitMessage": "chore(release): v${version}",
    "requireCleanWorkingDir": false
  },
  "github": {
    "release": true,
    "assets": [
      "frontend/build-publish/微信公众号采集器 Setup *.exe",
      "frontend/build-publish/微信公众号采集器-*.zip",
      "frontend/build-publish/latest.yml"
    ]
  },
  "hooks": {
    "after:bump": "node scripts/sync-version.js",
    "before:release": "node scripts/build-publish.js",
    "after:release": "node scripts/finalize-release.js"
  }
}
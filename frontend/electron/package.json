{
  "name": "wechat-collector-electron",
  "version": "4.2.5",
  "author": {
    "name": "honononong"
  },
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k -n next,electron -c blue,green \"npm run dev:next\" \"npm run dev:wait\"",
    "dev:next": "npm --prefix ../next run dev",
    "dev:wait": "wait-on http://localhost:3000 && electron .",
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "concurrently": "^10.0.5",
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.wechat.collector",
    "productName": "微信公众号采集器",
    "copyright": "Copyright © 2026 honononong",
    "directories": {
      "output": "../build"
    },
    "files": [
      "main.js",
      "icon.png",
      "out/**/*",
      "preload.js"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "icon.ico",
      "executableName": "WeChatCollector"
    },
    "electronVersion": "31.7.7",
    "publish": [
      {
        "provider": "github",
        "owner": "hong2301",
        "repo": "wechat-article-collector"
      }
    ],
    "extraResources": [
      {
        "from": "../../backend/dist/collector-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "oneClick": true,
      "allowElevation": true,
      "perMachine": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}

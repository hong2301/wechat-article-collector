# ==============================================================
# 端口/API 配置约定(前后端各自单点配置, 未配置走代码默认)
# 复制本文件内容到你需要的配置点即可, 不要直接改本模板
# ==============================================================

# ---------- 前端(配置点: frontend/next/.env.production / .env.development) ----------
# 生产版前端指向的后端地址(编译进产物; 不设则默认 http://127.0.0.1:8001)
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8001

# ---------- 后端(开发: backend/run.py 默认 8000; 生产: 由 Electron 拉起时下发) ----------
# 后端监听端口(开发/生产均读此变量; 不设则开发 8000 / 生产 8001)
BACKEND_PORT=8001

# ---------- 说明 ----------
# 开发环境:
#   前端 npm run dev 默认连 127.0.0.1:8000; 后端 python backend/run.py 默认监听 8000
#   需要换端口: 后端设 BACKEND_PORT, 前端在 frontend/next/.env.development 设 NEXT_PUBLIC_API_BASE
# 生产环境(打包):
#   Electron 拉起后端并下发 BACKEND_PORT; 前端产物内置 NEXT_PUBLIC_API_BASE(默认 8001)
#   两台同时跑不冲突: 开发 8000 / 生产 8001
# ---------- 版本注入(根目录 .env, 打包时 build.js 读入并生成 backend/app/version_info.py, 打进 exe) ----------
APP_VERSION=4.2.0          # 程序版本号(dev/打包统一读内置常量, 不再读数据库/package.json)
WECHAT_VERSION=4.1.13.12   # 微信基准版本(同上, 不再存 settings 表)
